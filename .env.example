# === Data ===
LIVELAPSE_DATA_DIR=/mnt/livelapse

# === Frame format ===
# Options: webp, png, jpg
LIVELAPSE_FORMAT=webp
# For webp: 1 = lossless. For jpg: quality 1-31 (lower = better)
LIVELAPSE_LOSSLESS=1
LIVELAPSE_JPEG_QUALITY=2

# === Stream capture ===
# Max resolution height to request from stream (e.g., 720, 1080)
LIVELAPSE_MAX_HEIGHT=720
# Seconds to wait before retrying after stream drop
LIVELAPSE_RETRY_DELAY=10

# === Alerting (optional, leave blank to disable) ===
RESEND_API_KEY=
ALERT_FROM=alerts@yourdomain.com
ALERT_TO=you@example.com

# === Health check ===
# Seconds with no new frames before considering a feed stale
HEALTHCHECK_STALE_SECONDS=120
# Disk usage percentage threshold for alert
HEALTHCHECK_DISK_THRESHOLD=80
