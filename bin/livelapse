#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(
  CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1
  pwd
)"

# shellcheck source=bin/common.sh
source "$SCRIPT_DIR/common.sh"

usage() {
  cat <<'EOF' >&2
Usage:
  bin/livelapse status
  bin/livelapse start [feed-name] [--dry-run] [--yes]
  bin/livelapse stop [feed-name] [--dry-run] [--yes]
  bin/livelapse logs <feed-name> [--lines <n>] [--follow|--no-follow]
  bin/livelapse peek <feed-name>
  bin/livelapse watch <feed-name> [--interval <seconds>] [--once]
  bin/livelapse preview <feed-name> [--playback-fps <fps>] [--output <path>] [--add-timestamp] [--timestamp-tz <zone>]
  bin/livelapse extract [feed-name] --manifest <file> [--date <YYYY-MM-DD>] [--manifest-tz <zone>] [--pad <n>] [--playback-fps <fps>] [--output <dir>] [--compile] [--add-timestamp] [--timestamp-tz <zone>]
  bin/livelapse extract <feed-name> --at <time> --date <YYYY-MM-DD> [--manifest-tz <zone>] [--pad <n>] [--label <text>] [--fragment <n>] [--add-timestamp] [--timestamp-tz <zone>]
  bin/livelapse caffeinate start
  bin/livelapse caffeinate stop
  bin/livelapse caffeinate status
EOF
}

CAFFEINATE_LABEL="com.veridian.livelapse.caffeinate"
DEFAULT_LOG_LINES=50
DEFAULT_PREVIEW_FPS=30
DEFAULT_TIMESTAMP_TZ="est"
PREVIEW_STAGE_DIR=""
PREVIEW_PROGRESS_INTERVAL=500
STOP_WAIT_ATTEMPTS=50
STOP_WAIT_INTERVAL_SECONDS=0.2
LIFECYCLE_DRY_RUN="no"
ASSUME_YES="no"
PARSED_FEED_NAME=""
RESOLVED_TARGET_SCOPE="single"
RESOLVED_TARGET_FEEDS=()

ensure_darwin() {
  if ! is_darwin; then
    log "caffeinate is only available on macOS"
    exit 1
  fi
}

caffeinate_target() {
  printf 'gui/%s/%s\n' "$(id -u)" "$CAFFEINATE_LABEL"
}

caffeinate_stdout_file() {
  printf '/tmp/livelapse_caffeinate_%s.out\n' "$(id -u)"
}

caffeinate_stderr_file() {
  printf '/tmp/livelapse_caffeinate_%s.err\n' "$(id -u)"
}

caffeinate_print() {
  launchctl print "$(caffeinate_target)" 2>/dev/null
}

caffeinate_pid() {
  local pid=""

  pid="$(
    caffeinate_print | awk -F'= ' '
    /^[[:space:]]*pid = / {
      print $2
      exit
    }
  '
  )"

  [[ -n "$pid" ]] || return 1
  printf '%s\n' "$pid"
}

wait_for_launchctl_state() {
  local desired="$1"
  local attempts=0

  while true; do
    if [[ "$desired" == "present" ]] && caffeinate_print >/dev/null; then
      return 0
    fi

    if [[ "$desired" == "absent" ]] && ! caffeinate_print >/dev/null; then
      return 0
    fi

    if (( attempts >= 50 )); then
      return 1
    fi

    sleep 0.1
    attempts=$((attempts + 1))
  done
}

caffeinate_start() {
  ensure_darwin
  ensure_command caffeinate
  ensure_command launchctl
  ensure_pids_dir

  local stdout_file stderr_file pid=""
  stdout_file="$(caffeinate_stdout_file)"
  stderr_file="$(caffeinate_stderr_file)"
  rm -f "$(caffeinate_pid_file)"

  if pid="$(caffeinate_pid)"; then
    printf 'caffeinate running (pid %s)\n' "$pid"
    return 0
  fi

  launchctl remove "$CAFFEINATE_LABEL" >/dev/null 2>&1 || true
  launchctl submit -l "$CAFFEINATE_LABEL" -o "$stdout_file" -e "$stderr_file" -- /usr/bin/caffeinate -dis

  if ! wait_for_launchctl_state present; then
    log "Failed to start caffeinate; see $stdout_file and $stderr_file"
    return 1
  fi

  pid="$(caffeinate_pid)"
  printf 'caffeinate started (pid %s)\n' "$pid"
}

caffeinate_stop() {
  ensure_darwin
  ensure_command launchctl
  ensure_pids_dir

  local pid=""
  rm -f "$(caffeinate_pid_file)"

  if ! pid="$(caffeinate_pid)"; then
    if caffeinate_print >/dev/null; then
      launchctl remove "$CAFFEINATE_LABEL" >/dev/null 2>&1 || true
    fi
    printf 'caffeinate stopped\n'
    return 0
  fi

  launchctl remove "$CAFFEINATE_LABEL"

  if ! wait_for_launchctl_state absent; then
    log "caffeinate did not stop cleanly (pid $pid)"
    return 1
  fi

  printf 'caffeinate stopped\n'
}

caffeinate_status() {
  ensure_darwin
  ensure_command launchctl
  ensure_pids_dir

  if pid="$(caffeinate_pid)"; then
    printf 'caffeinate running (pid %s)\n' "$pid"
    return 0
  fi

  printf 'caffeinate stopped\n'
}

ensure_feed_exists() {
  local feed_name="$1"

  validate_feed_name "$feed_name"

  if ! feed_record_by_name "$feed_name" >/dev/null; then
    log "Feed not found in feeds.conf: $feed_name"
    return 1
  fi
}

feed_data_dir() {
  local feed_name="$1"
  local data_dir="$2"

  printf '%s/%s\n' "$data_dir" "$feed_name"
}

latest_frame_path() {
  local feed_dir="$1"
  local frame_ext="$2"
  local min_bytes="${3:-1024}"
  local candidate=""

  [[ -d "$feed_dir" ]] || return 1

  # Walk backwards from newest; skip runt frames left by stream drops
  while IFS= read -r candidate; do
    if [[ "$(wc -c < "$candidate")" -ge "$min_bytes" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done < <(find "$feed_dir" -maxdepth 1 -type f -name "*.${frame_ext}" | LC_ALL=C sort -r)

  return 1
}

frame_count() {
  local feed_dir="$1"
  local frame_ext="$2"

  if [[ ! -d "$feed_dir" ]]; then
    printf '0\n'
    return 0
  fi

  find "$feed_dir" -maxdepth 1 -type f -name "*.${frame_ext}" | wc -l | tr -d '[:space:]'
}

frame_timestamp_for_display() {
  local frame_path="$1"
  local basename="${frame_path##*/}"
  local stem="${basename%.*}"

  printf '%s\n' "${stem//_/:}"
}

is_interactive_terminal() {
  [[ -t 0 && -t 1 ]]
}

lowercase_text() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

parse_lifecycle_args() {
  PARSED_FEED_NAME=""
  LIFECYCLE_DRY_RUN="no"
  ASSUME_YES="no"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run)
        LIFECYCLE_DRY_RUN="yes"
        ;;
      --yes|-y)
        ASSUME_YES="yes"
        ;;
      -*)
        log "Unknown lifecycle option: $1"
        return 1
        ;;
      *)
        if [[ -n "$PARSED_FEED_NAME" ]]; then
          log "Only one feed name may be provided"
          return 1
        fi
        PARSED_FEED_NAME="$1"
        ;;
    esac
    shift
  done
}

confirm_action() {
  local prompt="$1"
  local default_answer="${2:-no}"
  local reply normalized=""

  if [[ "$ASSUME_YES" == "yes" ]]; then
    return 0
  fi

  if ! is_interactive_terminal; then
    return 2
  fi

  while true; do
    if [[ "$default_answer" == "yes" ]]; then
      printf '%s [Y/n] ' "$prompt"
    else
      printf '%s [y/N] ' "$prompt"
    fi

    read -r reply
    normalized="$(lowercase_text "$reply")"

    case "$normalized" in
      y|yes)
        return 0
        ;;
      n|no)
        return 1
        ;;
      "")
        if [[ "$default_answer" == "yes" ]]; then
          return 0
        fi
        return 1
        ;;
      *)
        printf 'Please answer yes or no.\n' >&2
        ;;
    esac
  done
}

feed_state() {
  local feed_name="$1"

  if feed_running_pid "$feed_name" >/dev/null 2>&1; then
    printf 'running\n'
    return 0
  fi

  printf 'stopped\n'
}

load_filtered_feed_targets() {
  local target_state="$1"
  local feed_name state=""

  RESOLVED_TARGET_FEEDS=()

  while IFS= read -r feed_name; do
    state="$(feed_state "$feed_name")"
    if [[ "$state" != "$target_state" ]]; then
      continue
    fi
    RESOLVED_TARGET_FEEDS[${#RESOLVED_TARGET_FEEDS[@]}]="$feed_name"
  done < <(list_feed_names)
}

join_feed_names() {
  local result=""
  local index=0

  while (( index < ${#RESOLVED_TARGET_FEEDS[@]} )); do
    if [[ -n "$result" ]]; then
      result="${result}, "
    fi
    result="${result}${RESOLVED_TARGET_FEEDS[$index]}"
    index=$((index + 1))
  done

  printf '%s\n' "$result"
}

select_lifecycle_targets() {
  local operation="$1"
  local target_state="$2"
  local helper_note="${3:-}"
  local selection prompt=""
  local -a options
  local index=0
  local option_number=1
  local normalized=""

  options=()
  options[0]="__all__"

  if (( ${#RESOLVED_TARGET_FEEDS[@]} == 0 )); then
    printf 'No %s feeds are available to %s.\n' "$target_state" "$operation"
    return 1
  fi

  printf '%s feeds available to %s:\n' "$target_state" "$operation"
  printf '  0) all %s feeds\n' "$target_state"

  while (( index < ${#RESOLVED_TARGET_FEEDS[@]} )); do
    options[$option_number]="${RESOLVED_TARGET_FEEDS[$index]}"
    printf '  %s) %s\n' "$option_number" "${options[$option_number]}"
    index=$((index + 1))
    option_number=$((option_number + 1))
  done

  if [[ -n "$helper_note" ]]; then
    printf '%s\n' "$helper_note"
  fi

  prompt="Select a feed to $operation (0 for all, q to cancel): "

  while true; do
    printf '%s' "$prompt"
    read -r selection
    normalized="$(lowercase_text "$selection")"

    case "$normalized" in
      q|quit|cancel)
        return 2
        ;;
    esac

    if [[ "$selection" =~ ^[0-9]+$ ]] && (( selection < option_number )); then
      if (( selection == 0 )); then
        RESOLVED_TARGET_SCOPE="all"
        return 0
      fi

      RESOLVED_TARGET_SCOPE="single"
      RESOLVED_TARGET_FEEDS=("${options[$selection]}")
      return 0
    fi

    printf 'Enter one of the numbered options, or q to cancel.\n' >&2
  done
}

resolve_lifecycle_targets() {
  local operation="$1"
  local target_state helper_note=""
  local selection_status=0

  RESOLVED_TARGET_SCOPE="single"
  RESOLVED_TARGET_FEEDS=()

  if [[ -n "$PARSED_FEED_NAME" ]]; then
    ensure_feed_exists "$PARSED_FEED_NAME"
    RESOLVED_TARGET_FEEDS=("$PARSED_FEED_NAME")
    return 0
  fi

  case "$operation" in
    start)
      target_state="stopped"
      helper_note="Running feeds are hidden from this picker for safety. Use start <feed-name> if you want to restart one."
      ;;
    stop)
      target_state="running"
      ;;
    *)
      log "Unsupported lifecycle operation: $operation"
      return 1
      ;;
  esac

  load_filtered_feed_targets "$target_state"

  if (( ${#RESOLVED_TARGET_FEEDS[@]} == 0 )); then
    printf 'No %s feeds are available to %s.\n' "$target_state" "$operation"
    return 3
  fi

  if ! is_interactive_terminal; then
    RESOLVED_TARGET_SCOPE="all"
    return 0
  fi

  if select_lifecycle_targets "$operation" "$target_state" "$helper_note"; then
    selection_status=0
  else
    selection_status=$?
  fi

  if (( selection_status == 0 )); then
    return 0
  fi
  if (( selection_status == 2 )); then
    printf '%s cancelled.\n' "$operation"
    return 2
  fi

  return "$selection_status"
}

wait_for_pid_exit() {
  local pid="$1"
  local attempts="${2:-$STOP_WAIT_ATTEMPTS}"

  while (( attempts > 0 )); do
    if ! pid_is_running "$pid"; then
      return 0
    fi

    sleep "$STOP_WAIT_INTERVAL_SECONDS"
    attempts=$((attempts - 1))
  done

  return 1
}

signal_feed_process() {
  local signal="$1"
  local pid="$2"
  local target_pgid="" current_pgid=""

  target_pgid="$(pid_process_group "$pid" 2>/dev/null || true)"
  current_pgid="$(pid_process_group "$$" 2>/dev/null || true)"

  if [[ -n "$target_pgid" && "$target_pgid" != "$current_pgid" ]]; then
    if kill "-${signal}" -- "-${target_pgid}" 2>/dev/null; then
      return 0
    fi
  fi

  kill "-${signal}" "$pid" 2>/dev/null
}

start_local_feed() {
  local feed_name="$1"
  local capture_script pid_file log_file pid=""

  ensure_command python3
  ensure_pids_dir

  capture_script="$SCRIPT_DIR/capture.sh"
  pid_file="$(feed_pid_file "$feed_name")"
  log_file="$(feed_log_file "$feed_name")"

  nohup python3 -c 'import os, sys; os.setsid(); os.execv(sys.argv[1], sys.argv[1:])' \
    "$capture_script" "$feed_name" >"$log_file" 2>&1 < /dev/null &
  pid=$!

  printf '%s\n' "$pid" >"$pid_file"
  printf 'started %s (pid %s)\n' "$feed_name" "$pid"
}

stop_local_feed() {
  local feed_name="$1"
  local pid="$2"
  local pid_file

  pid_file="$(feed_pid_file "$feed_name")"

  if ! signal_feed_process TERM "$pid"; then
    log "Failed to signal $feed_name (pid $pid)"
    return 1
  fi

  if ! wait_for_pid_exit "$pid"; then
    log "$feed_name did not stop after SIGTERM; sending SIGKILL"
    signal_feed_process KILL "$pid" || true
    if ! wait_for_pid_exit "$pid" 10; then
      log "$feed_name did not stop cleanly"
      return 1
    fi
  fi

  rm -f "$pid_file"
  printf 'stopped %s\n' "$feed_name"
}

start_linux_feed() {
  local feed_name="$1"
  local unit

  unit="$(systemd_feed_unit "$feed_name")"
  run_as_root systemctl start "$unit"
  printf 'started %s\n' "$feed_name"
}

stop_linux_feed() {
  local feed_name="$1"
  local unit

  unit="$(systemd_feed_unit "$feed_name")"
  run_as_root systemctl stop "$unit"
  printf 'stopped %s\n' "$feed_name"
}

confirm_stop_targets() {
  local prompt=""
  local names=""
  local confirmation_status=0

  if [[ "$ASSUME_YES" == "yes" ]]; then
    return 0
  fi

  if (( ${#RESOLVED_TARGET_FEEDS[@]} == 1 )); then
    prompt="Stop ${RESOLVED_TARGET_FEEDS[0]}?"
  else
    names="$(join_feed_names)"
    prompt="Stop ${#RESOLVED_TARGET_FEEDS[@]} feeds (${names})?"
  fi

  if confirm_action "$prompt"; then
    confirmation_status=0
  else
    confirmation_status=$?
  fi

  if (( confirmation_status == 0 )); then
    return 0
  fi
  if (( confirmation_status == 2 )); then
    printf 'Refusing to stop feeds without interactive confirmation. Re-run with --yes if you really mean it.\n' >&2
    return 1
  fi

  printf 'stop cancelled.\n'
  return 2
}

filter_running_stop_targets() {
  local -a active_targets
  local index=0
  local feed_name=""

  active_targets=()

  while (( index < ${#RESOLVED_TARGET_FEEDS[@]} )); do
    feed_name="${RESOLVED_TARGET_FEEDS[$index]}"
    if feed_running_pid "$feed_name" >/dev/null 2>&1; then
      active_targets[${#active_targets[@]}]="$feed_name"
    else
      printf '%s is already stopped.\n' "$feed_name"
    fi
    index=$((index + 1))
  done

  RESOLVED_TARGET_FEEDS=("${active_targets[@]}")

  if (( ${#RESOLVED_TARGET_FEEDS[@]} == 0 )); then
    return 3
  fi

  return 0
}

maybe_restart_running_feed() {
  local feed_name="$1"
  local pid="$2"
  local prompt=""
  local confirmation_status=0

  printf '%s is already running (pid %s).\n' "$feed_name" "$pid"
  printf 'To capture the same source twice, duplicate the feeds.conf entry under a new feed name.\n'

  prompt="Stop the existing capture and start ${feed_name} again?"

  if confirm_action "$prompt"; then
    confirmation_status=0
  else
    confirmation_status=$?
  fi

  if (( confirmation_status == 0 )); then
    if [[ "$LIFECYCLE_DRY_RUN" == "yes" ]]; then
      printf '[dry-run] would stop %s (pid %s)\n' "$feed_name" "$pid"
      printf '[dry-run] would start %s\n' "$feed_name"
      return 10
    fi

    if is_linux; then
      stop_linux_feed "$feed_name"
    else
      stop_local_feed "$feed_name" "$pid"
    fi
    return 0
  fi

  if (( confirmation_status == 2 )); then
    printf 'Skipping %s. Re-run with --yes to restart it non-interactively.\n' "$feed_name"
    return 10
  fi

  printf 'Skipping %s.\n' "$feed_name"
  return 10
}

start_feed() {
  local feed_name="$1"
  local pid=""
  local restart_status=0

  ensure_feed_exists "$feed_name"

  if pid="$(feed_running_pid "$feed_name" 2>/dev/null)"; then
    if maybe_restart_running_feed "$feed_name" "$pid"; then
      restart_status=0
    else
      restart_status=$?
    fi
    if (( restart_status == 10 )); then
      return 0
    fi
    if (( restart_status != 0 )); then
      return "$restart_status"
    fi
  fi

  if [[ "$LIFECYCLE_DRY_RUN" == "yes" ]]; then
    printf '[dry-run] would start %s\n' "$feed_name"
    return 0
  fi

  if is_linux; then
    start_linux_feed "$feed_name"
    return 0
  fi

  start_local_feed "$feed_name"
}

stop_feed() {
  local feed_name="$1"
  local pid=""

  ensure_feed_exists "$feed_name"

  if ! pid="$(feed_running_pid "$feed_name" 2>/dev/null)"; then
    printf '%s is already stopped.\n' "$feed_name"
    return 0
  fi

  if [[ "$LIFECYCLE_DRY_RUN" == "yes" ]]; then
    printf '[dry-run] would stop %s (pid %s)\n' "$feed_name" "$pid"
    return 0
  fi

  if is_linux; then
    stop_linux_feed "$feed_name"
    return 0
  fi

  stop_local_feed "$feed_name" "$pid"
}

start_command() {
  local index=0
  local target_status=0

  parse_lifecycle_args "$@" || return 1
  ensure_feeds_exist
  ensure_pids_dir

  if resolve_lifecycle_targets start; then
    target_status=0
  else
    target_status=$?
  fi
  if (( target_status == 2 || target_status == 3 )); then
    return 0
  fi
  if (( target_status != 0 )); then
    return "$target_status"
  fi

  while (( index < ${#RESOLVED_TARGET_FEEDS[@]} )); do
    start_feed "${RESOLVED_TARGET_FEEDS[$index]}" || return 1
    index=$((index + 1))
  done
}

stop_command() {
  local index=0
  local target_status=0

  parse_lifecycle_args "$@" || return 1
  ensure_feeds_exist
  ensure_pids_dir

  if resolve_lifecycle_targets stop; then
    target_status=0
  else
    target_status=$?
  fi
  if (( target_status == 2 || target_status == 3 )); then
    return 0
  fi
  if (( target_status != 0 )); then
    return "$target_status"
  fi

  if filter_running_stop_targets; then
    target_status=0
  else
    target_status=$?
  fi
  if (( target_status == 3 )); then
    return 0
  fi
  if (( target_status != 0 )); then
    return "$target_status"
  fi

  if confirm_stop_targets; then
    :
  else
    target_status=$?
    if (( target_status == 2 )); then
      return 0
    fi
    return "$target_status"
  fi

  while (( index < ${#RESOLVED_TARGET_FEEDS[@]} )); do
    stop_feed "${RESOLVED_TARGET_FEEDS[$index]}" || return 1
    index=$((index + 1))
  done
}

status_command() {
  ensure_feeds_exist
  ensure_pids_dir
  load_env

  local data_dir frame_ext
  data_dir="$(resolved_data_dir)"
  frame_ext="$(frame_file_extension)"

  printf '%-16s %-8s %-8s %-22s %s\n' "FEED" "STATE" "PID" "LAST_FRAME_UTC" "FRAMES"

  while IFS= read -r feed_name; do
    local pid state feed_dir last_frame count

    state="stopped"
    pid="-"
    if pid="$(feed_running_pid "$feed_name" 2>/dev/null)"; then
      state="running"
    else
      pid="-"
    fi

    feed_dir="$(feed_data_dir "$feed_name" "$data_dir")"
    last_frame="-"
    if last_frame="$(latest_frame_path "$feed_dir" "$frame_ext" 2>/dev/null)"; then
      last_frame="$(frame_timestamp_for_display "$last_frame")"
    else
      last_frame="-"
    fi

    count="$(frame_count "$feed_dir" "$frame_ext")"

    printf '%-16s %-8s %-8s %-22s %s\n' "$feed_name" "$state" "$pid" "$last_frame" "$count"
  done < <(list_feed_names)
}

should_follow_logs() {
  local follow_mode="$1"

  case "$follow_mode" in
    yes)
      return 0
      ;;
    no)
      return 1
      ;;
    auto)
      [[ -t 1 ]]
      ;;
    *)
      return 1
      ;;
  esac
}

logs_command() {
  local feed_name="${1:-}"
  shift || true

  if [[ -z "$feed_name" ]]; then
    usage
    return 1
  fi

  ensure_feeds_exist
  ensure_feed_exists "$feed_name"
  ensure_pids_dir

  local lines="$DEFAULT_LOG_LINES"
  local follow_mode="auto"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --lines|-n)
        shift
        if [[ $# -eq 0 ]]; then
          log "Missing value for --lines"
          return 1
        fi
        lines="$1"
        ;;
      --follow)
        follow_mode="yes"
        ;;
      --no-follow)
        follow_mode="no"
        ;;
      *)
        log "Unknown logs option: $1"
        return 1
        ;;
    esac
    shift
  done

  if [[ ! "$lines" =~ ^[0-9]+$ ]] || (( lines <= 0 )); then
    log "--lines must be a positive integer"
    return 1
  fi

  if is_linux; then
    ensure_command journalctl
    if should_follow_logs "$follow_mode"; then
      exec journalctl -u "livelapse@${feed_name}" -n "$lines" -f
    fi
    journalctl -u "livelapse@${feed_name}" -n "$lines"
    return 0
  fi

  local log_file
  log_file="$(feed_log_file "$feed_name")"

  if [[ ! -f "$log_file" ]]; then
    log "No local log file found for $feed_name at $log_file"
    return 1
  fi

  if should_follow_logs "$follow_mode"; then
    exec tail -n "$lines" -f "$log_file"
  fi

  tail -n "$lines" "$log_file"
}

peek_command() {
  local feed_name="${1:-}"
  shift || true

  if [[ -z "$feed_name" ]]; then
    usage
    return 1
  fi

  if [[ $# -gt 0 ]]; then
    log "peek does not accept additional arguments"
    return 1
  fi

  ensure_feeds_exist
  ensure_feed_exists "$feed_name"
  load_env

  local data_dir frame_ext source_dir frame_path
  data_dir="$(resolved_data_dir)"
  frame_ext="$(frame_file_extension)"
  source_dir="$(feed_data_dir "$feed_name" "$data_dir")"

  if [[ ! -d "$source_dir" ]]; then
    log "No frame directory found for $feed_name at $source_dir"
    return 1
  fi

  if ! frame_path="$(latest_frame_path "$source_dir" "$frame_ext" 2>/dev/null)"; then
    log "No .$frame_ext frames found for $feed_name in $source_dir"
    return 1
  fi

  if [[ -t 1 ]]; then
    log "Refusing to write binary image data to an interactive terminal"
    log "Pipe to imgcat or redirect to a file instead; latest frame: $frame_path"
    return 1
  fi

  exec cat "$frame_path"
}

# ---------------------------------------------------------------------------
# watch — display the latest frame inline, optionally refreshing in a loop
# ---------------------------------------------------------------------------

DEFAULT_WATCH_INTERVAL=1

# Render an image inline using the iTerm2 inline-images protocol.
# Works in iTerm2 and any terminal that supports the OSC 1337 escape.
iterm2_show_image() {
  local file="$1"
  local b64
  b64="$(base64 < "$file")"
  printf '\033]1337;File=inline=1;preserveAspectRatio=1:%s\a\n' "$b64"
}

# Detect how we can display an image in this terminal.
# Returns the method name: chafa, viu, iterm2, or "none".
# Prefer chafa/viu over iTerm2 inline images — the iTerm2 protocol
# triggers a permission dialog per image which breaks watch loops.
detect_image_renderer() {
  if command -v chafa >/dev/null 2>&1; then
    printf 'chafa\n'
    return 0
  fi
  if command -v viu >/dev/null 2>&1; then
    printf 'viu\n'
    return 0
  fi
  # Kitty supports inline images without a permission dialog
  if [[ "${TERM:-}" == "xterm-kitty" ]]; then
    printf 'iterm2\n'
    return 0
  fi
  # iTerm2 — last resort due to the inline image permission prompt
  if [[ "${TERM_PROGRAM:-}" == "iTerm.app" || "${LC_TERMINAL:-}" == "iTerm2" ]]; then
    printf 'iterm2\n'
    return 0
  fi
  printf 'none\n'
}

# Display a single frame with the given renderer, plus a status line.
render_frame() {
  local renderer="$1"
  local frame_path="$2"
  local feed_name="$3"

  local basename
  basename="$(basename "$frame_path")"
  # Extract the timestamp from the filename (strip extension, restore colons)
  local ts="${basename%.*}"
  ts="${ts//_/:}"

  case "$renderer" in
    iterm2)
      iterm2_show_image "$frame_path"
      ;;
    chafa)
      chafa --size "${COLUMNS:-80}x" "$frame_path"
      ;;
    viu)
      viu -w "${COLUMNS:-80}" "$frame_path"
      ;;
  esac

  printf '\033[1m%s\033[0m  %s\n' "$feed_name" "$ts"
}

watch_command() {
  local feed_name="${1:-}"
  shift || true

  local interval="$DEFAULT_WATCH_INTERVAL"
  local once=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --interval)
        interval="${2:-}"
        if [[ -z "$interval" ]]; then
          log "--interval requires a value in seconds"
          return 1
        fi
        shift 2
        ;;
      --once)
        once=true
        shift
        ;;
      *)
        log "Unknown option: $1"
        return 1
        ;;
    esac
  done

  if [[ -z "$feed_name" ]]; then
    usage
    return 1
  fi

  ensure_feeds_exist
  ensure_feed_exists "$feed_name"
  load_env

  local data_dir frame_ext source_dir renderer
  data_dir="$(resolved_data_dir)"
  frame_ext="$(frame_file_extension)"
  source_dir="$(feed_data_dir "$feed_name" "$data_dir")"
  renderer="$(detect_image_renderer)"

  if [[ "$renderer" == "none" ]]; then
    log "No supported image renderer found"
    log "Install one of: chafa (brew install chafa), viu (brew install viu)"
    log "Or use iTerm2 / Kitty which support inline images natively"
    return 1
  fi

  if [[ ! -d "$source_dir" ]]; then
    log "No frame directory found for $feed_name at $source_dir"
    return 1
  fi

  local frame_path=""
  if ! frame_path="$(latest_frame_path "$source_dir" "$frame_ext")"; then
    log "No .$frame_ext frames found for $feed_name in $source_dir"
    return 1
  fi

  if "$once"; then
    render_frame "$renderer" "$frame_path" "$feed_name"
    return 0
  fi

  # Live-refresh loop — Ctrl-C to exit
  local prev_frame=""
  trap 'printf "\n"; log "Stopped watching $feed_name"; exit 0' INT

  log "Watching $feed_name (every ${interval}s) — Ctrl-C to stop"

  while true; do
    if frame_path="$(latest_frame_path "$source_dir" "$frame_ext" 2>/dev/null)"; then
      if [[ "$frame_path" != "$prev_frame" ]]; then
        # Clear screen and move cursor to top for a clean refresh
        printf '\033[2J\033[H'
        render_frame "$renderer" "$frame_path" "$feed_name"
        prev_frame="$frame_path"
      fi
    fi
    sleep "$interval"
  done
}

validate_positive_number() {
  local value="$1"
  local label="$2"

  if [[ ! "$value" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
    log "$label must be numeric"
    return 1
  fi

  if ! awk "BEGIN { exit !($value > 0) }"; then
    log "$label must be greater than 0"
    return 1
  fi
}

cleanup_preview_stage() {
  if [[ -n "${PREVIEW_STAGE_DIR:-}" ]]; then
    rm -rf "$PREVIEW_STAGE_DIR"
    PREVIEW_STAGE_DIR=""
  fi
}

generate_timestamp_subtitles() {
  local manifest_file="$1"
  local subtitles_file="$2"
  local playback_fps="$3"
  local requested_tz="$4"

  python3 - "$manifest_file" "$subtitles_file" "$playback_fps" "$requested_tz" <<'PY'
from __future__ import annotations

import sys
from datetime import datetime, timezone
from pathlib import Path
from zoneinfo import ZoneInfo, ZoneInfoNotFoundError


def ass_time(seconds: float) -> str:
    total_centis = int(round(seconds * 100))
    hours, remainder = divmod(total_centis, 360000)
    minutes, remainder = divmod(remainder, 6000)
    secs, centis = divmod(remainder, 100)
    return f"{hours}:{minutes:02d}:{secs:02d}.{centis:02d}"


def ass_escape(text: str) -> str:
    return text.replace("\\", r"\\").replace("{", r"\{").replace("}", r"\}")


def resolve_timezone(requested: str) -> str:
    aliases = {
        "est": "America/New_York",
        "edt": "America/New_York",
        "et": "America/New_York",
        "eastern": "America/New_York",
        "pst": "America/Los_Angeles",
        "pdt": "America/Los_Angeles",
        "pt": "America/Los_Angeles",
        "pacific": "America/Los_Angeles",
        "cst": "America/Chicago",
        "cdt": "America/Chicago",
        "ct": "America/Chicago",
        "mst": "America/Denver",
        "mdt": "America/Denver",
        "mt": "America/Denver",
        "utc": "UTC",
        "z": "UTC",
    }
    cleaned = requested.strip()
    return aliases.get(cleaned.lower(), cleaned)


manifest_path = Path(sys.argv[1])
subtitles_path = Path(sys.argv[2])
playback_fps = float(sys.argv[3])
requested_tz = sys.argv[4]
resolved_tz = resolve_timezone(requested_tz)

try:
    zone = ZoneInfo(resolved_tz)
except ZoneInfoNotFoundError:
    print(f"Unknown timezone: {requested_tz}", file=sys.stderr)
    sys.exit(1)

frame_paths = [line.strip() for line in manifest_path.read_text().splitlines() if line.strip()]
if not frame_paths:
    print("No frames available for timestamp subtitles", file=sys.stderr)
    sys.exit(1)

events: list[tuple[str, str, str]] = []
first_label = ""

for index, frame_path in enumerate(frame_paths):
    frame_stem = Path(frame_path).stem
    try:
        captured_at_utc = datetime.strptime(frame_stem, "%Y-%m-%dT%H_%M_%SZ").replace(tzinfo=timezone.utc)
    except ValueError:
        print(f"Could not parse frame timestamp from {frame_path}", file=sys.stderr)
        sys.exit(1)

    captured_at_local = captured_at_utc.astimezone(zone)
    label = captured_at_local.strftime("%Y-%m-%d %H:%M:%S %Z")
    if not first_label:
        first_label = label

    start_time = ass_time(index / playback_fps)
    end_time = ass_time((index + 1) / playback_fps)
    events.append((start_time, end_time, ass_escape(label)))

header = """[Script Info]
ScriptType: v4.00+
WrapStyle: 0
ScaledBorderAndShadow: yes
PlayResX: 1920
PlayResY: 1080

[V4+ Styles]
Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding
Style: Timestamp,Arial,28,&H00FFFFFF,&H000000FF,&H00202020,&H00000000,0,0,0,0,100,100,0,0,1,2,0,3,24,24,24,1

[Events]
Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text
"""

with subtitles_path.open("w", encoding="utf-8") as handle:
    handle.write(header)
    for start_time, end_time, label in events:
        handle.write(f"Dialogue: 0,{start_time},{end_time},Timestamp,,0,0,0,,{label}\n")

print(f"{resolved_tz}|{first_label}")
PY
}

preview_progress_interval() {
  local total_frames="$1"

  if (( total_frames <= 200 )); then
    printf '50\n'
    return 0
  fi

  if (( total_frames <= 1000 )); then
    printf '100\n'
    return 0
  fi

  printf '%s\n' "$PREVIEW_PROGRESS_INTERVAL"
}

preview_command() {
  local feed_name="${1:-}"
  shift || true

  if [[ -z "$feed_name" ]]; then
    usage
    return 1
  fi

  ensure_feeds_exist
  ensure_feed_exists "$feed_name"
  ensure_command ffmpeg
  load_env

  local playback_fps="$DEFAULT_PREVIEW_FPS"
  local output_path=""
  local add_timestamp="no"
  local timestamp_tz="$DEFAULT_TIMESTAMP_TZ"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --add-timestamp)
        add_timestamp="yes"
        ;;
      --playback-fps)
        shift
        if [[ $# -eq 0 ]]; then
          log "Missing value for --playback-fps"
          return 1
        fi
        playback_fps="$1"
        ;;
      --output)
        shift
        if [[ $# -eq 0 ]]; then
          log "Missing value for --output"
          return 1
        fi
        output_path="$1"
        ;;
      --timestamp-tz)
        shift
        if [[ $# -eq 0 ]]; then
          log "Missing value for --timestamp-tz"
          return 1
        fi
        timestamp_tz="$1"
        add_timestamp="yes"
        ;;
      *)
        log "Unknown preview option: $1"
        return 1
        ;;
    esac
    shift
  done

  validate_positive_number "$playback_fps" "--playback-fps"

  local data_dir frame_ext source_dir output_dir timestamp stage_dir manifest_file
  data_dir="$(resolved_data_dir)"
  frame_ext="$(frame_file_extension)"
  source_dir="$(feed_data_dir "$feed_name" "$data_dir")"

  if [[ ! -d "$source_dir" ]]; then
    log "No frame directory found for $feed_name at $source_dir"
    return 1
  fi

  if [[ -z "$output_path" ]]; then
    output_dir="$data_dir/output/intermediate"
    mkdir -p "$output_dir"
    timestamp="$(date -u +%Y-%m-%dT%H_%M_%SZ)"
    output_path="$output_dir/${feed_name}_${timestamp}.mp4"
  else
    output_path="$(realpath_portable "$output_path")"
    mkdir -p "$(dirname "$output_path")"
  fi

  stage_dir="$(mktemp -d "${TMPDIR:-/tmp}/${feed_name}.XXXXXX")"
  PREVIEW_STAGE_DIR="$stage_dir"
  manifest_file="$stage_dir/frames.txt"

  trap cleanup_preview_stage EXIT

  log "Preparing preview for $feed_name"
  log "Source: $source_dir"
  log "Output: $output_path"
  log "Scanning frame list (*.$frame_ext)"

  find "$source_dir" -maxdepth 1 -type f -name "*.${frame_ext}" | LC_ALL=C sort > "$manifest_file"

  local total_frames progress_interval
  total_frames="$(wc -l < "$manifest_file" | tr -d '[:space:]')"

  if [[ -z "$total_frames" || "$total_frames" == "0" ]]; then
    log "No .$frame_ext frames found for $feed_name in $source_dir"
    return 1
  fi

  progress_interval="$(preview_progress_interval "$total_frames")"
  log "Found $total_frames frame(s); staging under $stage_dir"

  local count=0
  while IFS= read -r frame_path; do
    local target_path
    [[ -n "$frame_path" ]] || continue
    count=$((count + 1))
    printf -v target_path '%s/%06d.%s' "$stage_dir" "$count" "$frame_ext"
    ln -s "$frame_path" "$target_path"

    if (( count % progress_interval == 0 )) || (( count == total_frames )); then
      log "Staged $count/$total_frames frame(s)"
    fi
  done < "$manifest_file"

  local video_filter subtitle_file resolved_timestamp_tz first_overlay_label overlay_info
  video_filter='pad=ceil(iw/2)*2:ceil(ih/2)*2'

  if [[ "$add_timestamp" == "yes" ]]; then
    ensure_command python3
    subtitle_file="$stage_dir/timestamp.ass"
    overlay_info="$(generate_timestamp_subtitles "$manifest_file" "$subtitle_file" "$playback_fps" "$timestamp_tz")"
    IFS='|' read -r resolved_timestamp_tz first_overlay_label <<<"$overlay_info"
    log "Timestamp overlay enabled (requested $timestamp_tz, resolved $resolved_timestamp_tz)"
    log "First burned label: $first_overlay_label"
    video_filter="${video_filter},ass='${subtitle_file}'"
  fi

  log "Starting ffmpeg render at ${playback_fps} fps"

  if [[ -t 2 ]]; then
    ffmpeg \
      -y \
      -hide_banner \
      -loglevel error \
      -stats_period 2 \
      -stats \
      -framerate "$playback_fps" \
      -i "$stage_dir/%06d.${frame_ext}" \
      -vf "$video_filter" \
      -c:v libx264 \
      -pix_fmt yuv420p \
      -movflags +faststart \
      "$output_path"
  else
    ffmpeg \
      -y \
      -hide_banner \
      -loglevel error \
      -framerate "$playback_fps" \
      -i "$stage_dir/%06d.${frame_ext}" \
      -vf "$video_filter" \
      -c:v libx264 \
      -pix_fmt yuv420p \
      -movflags +faststart \
      "$output_path"
  fi

  local duration_seconds
  duration_seconds="$(awk "BEGIN { printf \"%.2f\", $count / $playback_fps }")"

  cleanup_preview_stage
  trap - EXIT

  log "Preview render complete"
  printf 'preview written to %s\n' "$output_path"
  printf 'frames=%s playback_fps=%s duration=%ss\n' "$count" "$playback_fps" "$duration_seconds"
}

# ---------------------------------------------------------------------------
# extract — pull timestamped fragments from captured frames
# ---------------------------------------------------------------------------

EXTRACT_STAGE_DIR=""

cleanup_extract_stage() {
  if [[ -n "${EXTRACT_STAGE_DIR:-}" ]]; then
    rm -rf "$EXTRACT_STAGE_DIR"
    EXTRACT_STAGE_DIR=""
  fi
}

render_extract_fragment() {
  local frag_manifest="$1"
  local output_path="$2"
  local playback_fps="$3"
  local frame_ext="$4"
  local frag_stage_dir="$5"
  local add_timestamp="${6:-no}"
  local timestamp_tz="${7:-$DEFAULT_TIMESTAMP_TZ}"
  local fragment_label="${8:-fragment}"

  local count=0
  while IFS= read -r frame_path; do
    [[ -n "$frame_path" ]] || continue
    count=$((count + 1))
    local target_path
    printf -v target_path '%s/%06d.%s' "$frag_stage_dir" "$count" "$frame_ext"
    ln -s "$frame_path" "$target_path"
  done < "$frag_manifest"

  if (( count == 0 )); then
    return 1
  fi

  local video_filter='pad=ceil(iw/2)*2:ceil(ih/2)*2'

  if [[ "$add_timestamp" == "yes" ]]; then
    local subtitle_file="$frag_stage_dir/timestamp.ass"
    local overlay_info resolved_timestamp_tz first_overlay_label
    overlay_info="$(generate_timestamp_subtitles "$frag_manifest" "$subtitle_file" "$playback_fps" "$timestamp_tz")"
    IFS='|' read -r resolved_timestamp_tz first_overlay_label <<<"$overlay_info"
    log "Timestamp overlay enabled for $fragment_label (requested $timestamp_tz, resolved $resolved_timestamp_tz)"
    log "First burned label: $first_overlay_label"
    video_filter="${video_filter},ass='${subtitle_file}'"
  fi

  ffmpeg \
    -nostdin \
    -y \
    -hide_banner \
    -loglevel error \
    -framerate "$playback_fps" \
    -i "$frag_stage_dir/%06d.${frame_ext}" \
    -vf "$video_filter" \
    -c:v libx264 \
    -pix_fmt yuv420p \
    -movflags +faststart \
    "$output_path"

  printf '%s\n' "$count"
}

extract_command() {
  local feed_name=""
  local extract_date=""
  local manifest_file=""
  local manifest_tz="$DEFAULT_TIMESTAMP_TZ"
  local manifest_tz_explicit="no"
  local at_time=""
  local from_time=""
  local to_time=""
  local pad_left="0"
  local pad_right="0"
  local label=""
  local fragment_start="1"
  local playback_fps="$DEFAULT_PREVIEW_FPS"
  local output_dir=""
  local compile="no"
  local add_timestamp="no"
  local timestamp_tz="$DEFAULT_TIMESTAMP_TZ"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --add-timestamp)
        add_timestamp="yes"
        ;;
      --timestamp-tz)
        shift
        if [[ $# -eq 0 ]]; then log "Missing value for --timestamp-tz"; return 1; fi
        timestamp_tz="$1"
        add_timestamp="yes"
        ;;
      --date)
        shift
        if [[ $# -eq 0 ]]; then log "Missing value for --date"; return 1; fi
        extract_date="$1"
        ;;
      --manifest-tz)
        shift
        if [[ $# -eq 0 ]]; then log "Missing value for --manifest-tz"; return 1; fi
        manifest_tz="$1"
        manifest_tz_explicit="yes"
        ;;
      --manifest)
        shift
        if [[ $# -eq 0 ]]; then log "Missing value for --manifest"; return 1; fi
        manifest_file="$1"
        ;;
      --at)
        shift
        if [[ $# -eq 0 ]]; then log "Missing value for --at"; return 1; fi
        at_time="$1"
        ;;
      --from)
        shift
        if [[ $# -eq 0 ]]; then log "Missing value for --from"; return 1; fi
        from_time="$1"
        ;;
      --to)
        shift
        if [[ $# -eq 0 ]]; then log "Missing value for --to"; return 1; fi
        to_time="$1"
        ;;
      --pad)
        shift
        if [[ $# -eq 0 ]]; then log "Missing value for --pad"; return 1; fi
        pad_left="$1"
        pad_right="$1"
        ;;
      --pad-left)
        shift
        if [[ $# -eq 0 ]]; then log "Missing value for --pad-left"; return 1; fi
        pad_left="$1"
        ;;
      --pad-right)
        shift
        if [[ $# -eq 0 ]]; then log "Missing value for --pad-right"; return 1; fi
        pad_right="$1"
        ;;
      --label)
        shift
        if [[ $# -eq 0 ]]; then log "Missing value for --label"; return 1; fi
        label="$1"
        ;;
      --fragment)
        shift
        if [[ $# -eq 0 ]]; then log "Missing value for --fragment"; return 1; fi
        fragment_start="$1"
        ;;
      --playback-fps)
        shift
        if [[ $# -eq 0 ]]; then log "Missing value for --playback-fps"; return 1; fi
        playback_fps="$1"
        ;;
      --output)
        shift
        if [[ $# -eq 0 ]]; then log "Missing value for --output"; return 1; fi
        output_dir="$1"
        ;;
      --compile)
        compile="yes"
        ;;
      -*)
        log "Unknown extract option: $1"
        return 1
        ;;
      *)
        if [[ -n "$feed_name" ]]; then
          log "Only one feed name may be provided"
          return 1
        fi
        feed_name="$1"
        ;;
    esac
    shift
  done

  if [[ -z "$manifest_file" && -z "$at_time" && -z "$from_time" ]]; then
    log "Provide --manifest <file>, --at <time>, or --from <time>"
    return 1
  fi

  if [[ -n "$manifest_file" && ( -n "$at_time" || -n "$from_time" ) ]]; then
    log "--manifest cannot be combined with --at or --from"
    return 1
  fi

  if [[ -n "$manifest_file" && ! -f "$manifest_file" ]]; then
    log "Manifest file not found: $manifest_file"
    return 1
  fi

  # Extract manifest headers: # feed:, # date:, and # timezone:
  if [[ -n "$manifest_file" ]]; then
    local header_val=""
    if [[ -z "$feed_name" ]]; then
      header_val="$(grep -m1 '^[[:space:]]*#[[:space:]]*feed:' "$manifest_file" | sed 's/^[[:space:]]*#[[:space:]]*feed:[[:space:]]*//' | tr -d '[:space:]')" || true
      if [[ -n "$header_val" ]]; then
        feed_name="$header_val"
      fi
    fi
    if [[ -z "$extract_date" ]]; then
      header_val="$(grep -m1 '^[[:space:]]*#[[:space:]]*date:' "$manifest_file" | sed 's/^[[:space:]]*#[[:space:]]*date:[[:space:]]*//' | tr -d '[:space:]')" || true
      if [[ -n "$header_val" ]]; then
        extract_date="$header_val"
      fi
    fi
    if [[ "$manifest_tz_explicit" == "no" ]]; then
      header_val="$(
        grep -E -m1 '^[[:space:]]*#[[:space:]]*(timezone|manifest-tz):' "$manifest_file" \
          | sed -E 's/^[[:space:]]*#[[:space:]]*(timezone|manifest-tz):[[:space:]]*//' \
          | tr -d '[:space:]'
      )" || true
      if [[ -n "$header_val" ]]; then
        manifest_tz="$header_val"
      fi
    fi
  fi

  if [[ -z "$feed_name" ]]; then
    log "Feed name required: provide as argument or # feed: header in manifest"
    return 1
  fi

  validate_positive_number "$playback_fps" "--playback-fps"

  ensure_feeds_exist
  ensure_feed_exists "$feed_name"
  ensure_command ffmpeg
  ensure_command python3
  load_env

  local data_dir frame_ext source_dir
  data_dir="$(resolved_data_dir)"
  frame_ext="$(frame_file_extension)"
  source_dir="$(feed_data_dir "$feed_name" "$data_dir")"

  if [[ ! -d "$source_dir" ]]; then
    log "No frame directory found for $feed_name at $source_dir"
    return 1
  fi

  if [[ -z "$output_dir" ]]; then
    output_dir="$data_dir/output/extracts/$feed_name"
  else
    output_dir="$(realpath_portable "$output_dir")"
  fi
  mkdir -p "$output_dir"

  local stage_dir
  stage_dir="$(mktemp -d "${TMPDIR:-/tmp}/extract_${feed_name}.XXXXXX")"
  EXTRACT_STAGE_DIR="$stage_dir"
  trap cleanup_extract_stage EXIT

  # Build manifest input for single-entry mode
  local manifest_input="$manifest_file"
  if [[ -z "$manifest_input" ]]; then
    manifest_input="$stage_dir/single_manifest.txt"
    local ts_spec=""
    if [[ -n "$at_time" ]]; then
      ts_spec="$at_time"
    elif [[ -n "$from_time" ]]; then
      ts_spec="$from_time"
      if [[ -n "$to_time" ]]; then
        ts_spec="${from_time}-${to_time}"
      fi
    fi
    printf '%s | %s\n' "$ts_spec" "${label:-$ts_spec}" > "$manifest_input"
  fi

  # Build master frame list
  local all_frames_file="$stage_dir/all_frames.txt"
  find "$source_dir" -maxdepth 1 -type f -name "*.${frame_ext}" | LC_ALL=C sort > "$all_frames_file"

  local total_frames
  total_frames="$(wc -l < "$all_frames_file" | tr -d '[:space:]')"

  if [[ -z "$total_frames" || "$total_frames" == "0" ]]; then
    log "No .$frame_ext frames found for $feed_name in $source_dir"
    return 1
  fi

  log "Extracting fragments from $feed_name"
  log "Source: $source_dir ($total_frames frames)"
  log "Output: $output_dir"
  log "Short manifest timestamps are interpreted in $manifest_tz and converted to UTC for frame selection"

  if [[ "$add_timestamp" == "yes" ]]; then
    log "Burned labels display in $timestamp_tz"
  fi

  # Parse manifest and select frames per fragment
  python3 - "$all_frames_file" "$stage_dir" "$extract_date" "$pad_left" "$pad_right" "$fragment_start" "$manifest_input" "$manifest_tz" <<'PYEOF'
from __future__ import annotations

import bisect
import re
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path
from zoneinfo import ZoneInfo, ZoneInfoNotFoundError


def slugify(text: str) -> str:
    slug = re.sub(r'[^a-z0-9]+', '-', text.lower().strip())
    return re.sub(r'-+', '-', slug).strip('-')[:60] or 'fragment'


def resolve_timezone(requested: str) -> str:
    aliases = {
        "est": "America/New_York",
        "edt": "America/New_York",
        "et": "America/New_York",
        "eastern": "America/New_York",
        "pst": "America/Los_Angeles",
        "pdt": "America/Los_Angeles",
        "pt": "America/Los_Angeles",
        "pacific": "America/Los_Angeles",
        "cst": "America/Chicago",
        "cdt": "America/Chicago",
        "ct": "America/Chicago",
        "mst": "America/Denver",
        "mdt": "America/Denver",
        "mt": "America/Denver",
        "utc": "UTC",
        "z": "UTC",
    }
    cleaned = requested.strip()
    return aliases.get(cleaned.lower(), cleaned)


def parse_time(raw: str, date_prefix: str, manifest_zone: ZoneInfo) -> datetime:
    t = raw.strip()
    # Full ISO: 2026-04-06T09:07:00Z or 2026-04-06T09_07_00Z
    if 'T' in t and len(t) > 10:
        t_norm = t.replace('_', ':').rstrip('Z')
        for fmt in ('%Y-%m-%dT%H:%M:%S', '%Y-%m-%dT%H:%M'):
            try:
                return datetime.strptime(t_norm, fmt).replace(tzinfo=timezone.utc)
            except ValueError:
                continue
    # HH:MM:SS
    if re.match(r'^\d{1,2}:\d{2}:\d{2}$', t):
        if not date_prefix:
            print(f'--date required for short timestamp: {t}', file=sys.stderr)
            sys.exit(1)
        parts = t.split(':')
        h = parts[0].zfill(2)
        local_dt = datetime.strptime(
            f'{date_prefix}T{h}:{parts[1]}:{parts[2]}', '%Y-%m-%dT%H:%M:%S'
        ).replace(tzinfo=manifest_zone)
        return local_dt.astimezone(timezone.utc)
    # HH:MM
    if re.match(r'^\d{1,2}:\d{2}$', t):
        if not date_prefix:
            print(f'--date required for short timestamp: {t}', file=sys.stderr)
            sys.exit(1)
        parts = t.split(':')
        h = parts[0].zfill(2)
        local_dt = datetime.strptime(
            f'{date_prefix}T{h}:{parts[1]}:00', '%Y-%m-%dT%H:%M:%S'
        ).replace(tzinfo=manifest_zone)
        return local_dt.astimezone(timezone.utc)
    print(f'Cannot parse timestamp: {t}', file=sys.stderr)
    sys.exit(1)


def has_seconds(raw: str) -> bool:
    return len(raw.strip().split(':')) >= 3


def parse_spec(spec: str, date_prefix: str, manifest_zone: ZoneInfo) -> tuple[datetime, datetime]:
    spec = spec.strip()
    # Range: HH:MM-HH:MM or HH:MM:SS-HH:MM:SS
    m = re.match(
        r'^(\d{1,2}:\d{2}(?::\d{2})?)\s*-\s*(\d{1,2}:\d{2}(?::\d{2})?)$', spec
    )
    if m:
        s = parse_time(m.group(1), date_prefix, manifest_zone)
        e = parse_time(m.group(2), date_prefix, manifest_zone)
        if e < s:
            s, e = e, s
        if not has_seconds(m.group(2)):
            e += timedelta(seconds=59)
        return s, e
    # Multi-point: comma-separated
    if ',' in spec:
        raw_parts = [p.strip() for p in spec.split(',')]
        windows = []
        for raw in raw_parts:
            t = parse_time(raw, date_prefix, manifest_zone)
            if has_seconds(raw):
                windows.append((t, t))
            else:
                windows.append((t, t + timedelta(seconds=59)))
        return min(w[0] for w in windows), max(w[1] for w in windows)
    # Single timestamp
    s = parse_time(spec, date_prefix, manifest_zone)
    if has_seconds(spec):
        return s, s
    return s, s + timedelta(seconds=59)


# --- Main ---

all_frames_file = Path(sys.argv[1])
stage_dir = Path(sys.argv[2])
date_prefix = sys.argv[3]
default_pl = int(sys.argv[4])
default_pr = int(sys.argv[5])
frag_start = int(sys.argv[6])
manifest_path = Path(sys.argv[7])
manifest_tz_requested = sys.argv[8]

resolved_manifest_tz = resolve_timezone(manifest_tz_requested)
try:
    manifest_zone = ZoneInfo(resolved_manifest_tz)
except ZoneInfoNotFoundError:
    print(f'Unknown manifest timezone: {manifest_tz_requested}', file=sys.stderr)
    sys.exit(1)

# Load sorted frame list and parse timestamps from filenames
frames: list[tuple[datetime, str]] = []
for line in all_frames_file.read_text().splitlines():
    line = line.strip()
    if not line:
        continue
    stem = Path(line).stem
    try:
        dt = datetime.strptime(stem, '%Y-%m-%dT%H_%M_%SZ').replace(tzinfo=timezone.utc)
        frames.append((dt, line))
    except ValueError:
        continue

if not frames:
    print('No parseable frames found', file=sys.stderr)
    sys.exit(1)

frame_dts = [f[0] for f in frames]

# Parse manifest
LINE_DATE_RE = re.compile(r'^(\d{4}-\d{2}-\d{2})\s+(.*)')

entries: list[tuple[datetime, datetime, str, int, int]] = []
for line in manifest_path.read_text().splitlines():
    line = line.strip()
    if not line or line.startswith('#'):
        continue
    parts = [p.strip() for p in line.split('|')]
    ts = parts[0]
    # Per-line date override: "2026-04-07 12:03-12:20" extracts the date
    line_date = date_prefix
    m = LINE_DATE_RE.match(ts)
    if m:
        line_date = m.group(1)
        ts = m.group(2)
    label = parts[1] if len(parts) > 1 and parts[1] else ts
    if len(parts) > 2 and parts[2]:
        pl = int(parts[2])
        pr = int(parts[3]) if len(parts) > 3 and parts[3] else pl
    else:
        pl = default_pl
        pr = default_pr
    start, end = parse_spec(ts, line_date, manifest_zone)
    entries.append((start, end, label, pl, pr))

if not entries:
    print('No entries found in manifest', file=sys.stderr)
    sys.exit(1)

# Select frames per entry
meta: list[str] = []
for i, (start, end, label, pl, pr) in enumerate(entries):
    frag_num = frag_start + i
    si = bisect.bisect_left(frame_dts, start)
    ei = bisect.bisect_right(frame_dts, end)
    core_count = ei - si
    if core_count == 0:
        print(
            f'Warning: no frames for fragment {frag_num:03d} ({label}): '
            f'{start.isoformat()} to {end.isoformat()}',
            file=sys.stderr,
        )
        continue
    ps = max(0, si - pl)
    pe = min(len(frames), ei + pr)
    selected = [frames[j][1] for j in range(ps, pe)]
    frag_file = stage_dir / f'frag_{frag_num:03d}.txt'
    frag_file.write_text('\n'.join(selected) + '\n')
    meta.append(
        '|'.join(
            [
                f'{frag_num:03d}',
                slugify(label),
                str(len(selected)),
                label,
                start.isoformat(),
                end.isoformat(),
                frames[si][0].isoformat(),
                frames[ei - 1][0].isoformat(),
                frames[ps][0].isoformat(),
                frames[pe - 1][0].isoformat(),
                str(pl),
                str(pr),
            ]
        )
    )

summary = stage_dir / 'fragments.txt'
summary.write_text('\n'.join(meta) + '\n')
print(f'Prepared {len(meta)} fragment(s) from {len(entries)} entries', file=sys.stderr)
PYEOF

  # Read fragments summary and render each
  local fragments_file="$stage_dir/fragments.txt"
  if [[ ! -f "$fragments_file" ]] || [[ ! -s "$fragments_file" ]]; then
    log "No fragments were produced"
    return 1
  fi

  local frag_count=0
  local concat_list="$stage_dir/concat.txt"

  while IFS='|' read -r frag_num frag_slug frag_frames frag_label requested_start requested_end core_start core_end selected_start selected_end frag_pad_left frag_pad_right; do
    [[ -n "$frag_num" ]] || continue
    frag_count=$((frag_count + 1))

    local frag_manifest="$stage_dir/frag_${frag_num}.txt"
    local frag_stage="$stage_dir/stage_${frag_num}"
    local output_file="$output_dir/${frag_num}_${frag_slug}.mp4"

    mkdir -p "$frag_stage"

    log "Rendering fragment $frag_num: $frag_label ($frag_frames frames)"
    log "Requested UTC window: $requested_start to $requested_end"
    log "Core frame UTC window: $core_start to $core_end"
    log "Selected UTC window: $selected_start to $selected_end (pad-left=$frag_pad_left frames, pad-right=$frag_pad_right frames)"

    local rendered_frames
    rendered_frames="$(render_extract_fragment "$frag_manifest" "$output_file" "$playback_fps" "$frame_ext" "$frag_stage" "$add_timestamp" "$timestamp_tz" "$frag_num")"

    local duration
    duration="$(awk "BEGIN { printf \"%.2f\", $rendered_frames / $playback_fps }")"
    printf 'fragment %s written to %s (%s frames, %ss)\n' "$frag_num" "$output_file" "$rendered_frames" "$duration"

    if [[ "$compile" == "yes" ]]; then
      printf "file '%s'\n" "$output_file" >> "$concat_list"
    fi
  done < "$fragments_file"

  if [[ "$compile" == "yes" ]] && (( frag_count > 1 )); then
    local compilation_output="$output_dir/compilation.mp4"
    log "Compiling $frag_count fragments"

    ffmpeg \
      -y \
      -hide_banner \
      -loglevel error \
      -f concat \
      -safe 0 \
      -i "$concat_list" \
      -c copy \
      -movflags +faststart \
      "$compilation_output"

    printf 'compilation written to %s\n' "$compilation_output"
  fi

  cleanup_extract_stage
  trap - EXIT

  log "Extract complete: $frag_count fragment(s)"
}

main() {
  local command="${1:-}"

  if [[ $# -gt 0 ]]; then
    shift
  fi

  case "$command" in
    status)
      status_command "$@"
      ;;
    start)
      start_command "$@"
      ;;
    stop)
      stop_command "$@"
      ;;
    logs)
      logs_command "$@"
      ;;
    peek)
      peek_command "$@"
      ;;
    watch)
      watch_command "$@"
      ;;
    preview)
      preview_command "$@"
      ;;
    extract)
      extract_command "$@"
      ;;
    caffeinate)
      local subcommand="${1:-}"
      case "$subcommand" in
        start)
          caffeinate_start
          ;;
        stop)
          caffeinate_stop
          ;;
        status)
          caffeinate_status
          ;;
        *)
          usage
          exit 1
          ;;
      esac
      ;;
    *)
      usage
      exit 1
      ;;
  esac
}

main "$@"
